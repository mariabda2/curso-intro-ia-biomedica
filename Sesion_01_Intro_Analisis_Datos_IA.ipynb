        "# ============================================================\n",
        "#  CELDA 3.1 — Cargar el dataset Iris\n",
        "# ============================================================\n",
        "\n",
        "from sklearn.datasets import load_iris\n",
        "\n",
        "# Cargamos el dataset\n",
        "iris_raw = load_iris()\n",
        "\n",
        "# Convertimos a un DataFrame de Pandas (tabla)\n",
        "df = pd.DataFrame(\n",
        "    data=iris_raw.data,\n",
        "    columns=iris_raw.feature_names\n",
        ")\n",
        "\n",
        "# Agregamos la columna de especie (en texto, no número)\n",
        "df['especie'] = [iris_raw.target_names[i] for i in iris_raw.target]\n",
        "\n",
