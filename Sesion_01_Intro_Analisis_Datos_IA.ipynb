      "source": [
        "# ============================================================\n",
        "#  CELDA 5.1 — K-Means Clustering (Aprendizaje No Supervisado)\n",
        "#\n",
        "#  El algoritmo intentará agrupar las flores en 3 grupos\n",
        "#  sin saber nada sobre las especies reales.\n",
        "# ============================================================\n",
        "\n",
        "from sklearn.cluster import KMeans\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "\n",
        "# Seleccionamos solo las columnas numéricas\n",
        "X = df[['largo_sepalo_cm', 'ancho_sepalo_cm',\n",
        "        'largo_petalo_cm', 'ancho_petalo_cm']]\n",
        "\n",
        "# Escalamos los datos (importante para K-Means)\n",
        "# Esto hace que todas las variables tengan la misma escala\n",
        "scaler = StandardScaler()\n",
        "X_scaled = scaler.fit_transform(X)\n",
        "\n",
        "# Aplicamos K-Means con k=3 (tres grupos, como las tres especies)\n",
        "kmeans = KMeans(n_clusters=3, random_state=42, n_init=10)\n",
        "df['grupo_kmeans'] = kmeans.fit_predict(X_scaled)\n",
        "\n",
        "print('✅ K-Means aplicado con k=3 grupos.')\n",
        "print('\\n📊 Distribución de flores por grupo encontrado:')\n",
        "print(df['grupo_kmeans'].value_counts().sort_index())\n",
        "\n",
        "print('\\n🔎 Comparación grupos K-Means vs. especies reales:')\n",
        "print(pd.crosstab(df['grupo_kmeans'], df['especie']))"
      ]
    },
