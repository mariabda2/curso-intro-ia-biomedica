      ],
      "source": [
        "# ============================================================\n",
        "#  CELDA 5.3 — ¿Qué variables fueron más importantes?\n",
        "#\n",
        "#  El árbol de decisión nos dice cuánto contribuyó\n",
        "#  cada variable a tomar decisiones correctas.\n",
        "# ============================================================\n",
        "\n",
        "importancias = pd.Series(\n",
        "    modelo.feature_importances_,\n",
        "    index=X.columns\n",
        ").sort_values(ascending=False)\n",
        "\n",
        "print('📊 Importancia de cada variable para el modelo:')\n",
        "print()\n",
        "for variable, importancia in importancias.items():\n",
        "    barra = '█' * int(importancia * 40)\n",
        "    print(f'  {variable:<22} {barra} {importancia:.3f}')"
      ]
    },
