        "mediana_edad = titanic_limpio['Age'].median()\n",
        "titanic_limpio['Age'].fillna(mediana_edad, inplace=True)\n",
        "print(f'✅ Edad faltante imputada con la mediana: {mediana_edad:.1f} años')\n",
        "\n",
        "# 2. Imputar 'Embarked' con el valor más frecuente (moda)\n",
        "moda_embarked = titanic_limpio['Embarked'].mode()[0]\n",
        "titanic_limpio['Embarked'].fillna(moda_embarked, inplace=True)\n",
        "print(f'✅ Puerto de embarque imputado con la moda: \"{moda_embarked}\"')\n",
        "\n",
